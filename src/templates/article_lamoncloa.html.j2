{% extends "base.html.j2" %}
{% set assets_path = "../assets/style.css" %}
{% set root_path = "../index.html" %}
{% set zh = article.zh | default({}) %}

{% block footer_source %}<a href="https://www.lamoncloa.gob.es/serviciosdeprensa/notasprensa/Paginas/index.aspx" target="_blank" rel="noopener">La Moncloa / Gobierno de España</a>{% endblock %}

{% block title %}{{ zh.chinese_title | default(article.title) }} · 马德里今日生活情报{% endblock %}

{% block content %}
<div class="article-page">

  <!-- 顶部图片区 -->
  {% if article.thumbnail %}
  <div class="article-hero-img">
    <img src="{{ article.thumbnail }}" alt="{{ zh.chinese_title | default('') }}" onerror="this.parentElement.style.display='none'" />
    <div class="img-credit">图片来源：La Moncloa / Gobierno de España</div>
  </div>
  {% endif %}

  <div class="container">
    <nav class="breadcrumb">
      <a href="../index.html">首页</a> <span>›</span> 西班牙全国重点
    </nav>

    <article class="article-content">

      <!-- 标签区 -->
      <div class="article-badges">
        <span class="badge imp-badge imp-{{ article.importance | lower }}">
          {% if article.importance == 'S' %}⚡ 必须关注
          {% elif article.importance == 'A' %}⭐ 值得关注
          {% elif article.importance == 'B' %}📌 可参考
          {% else %}📄 仅供参考{% endif %}
        </span>
        <span class="badge" style="background:#1d4ed8;color:#fff;font-size:0.72rem;">🏛 {{ article.department | truncate(20, true, '…') }}</span>
        {% for tag in (article.tags | default([]))[:4] %}
        <span class="badge label-badge">{{ tag }}</span>
        {% endfor %}
      </div>

      <!-- 标题区 -->
      <header class="article-header">
        <h1 class="article-title">{{ zh.chinese_title | default(article.title) }}</h1>
        {% if zh.one_line_summary %}
        <p class="article-lead">{{ zh.one_line_summary }}</p>
        {% endif %}
        <div class="article-meta-row">
          {% if article.date %}<span>🗓 {{ article.date }}</span>{% endif %}
          {% if article.valid_until %}<span style="color:#92400e;">有效至 {{ article.valid_until }}</span>{% endif %}
          <a class="meta-source" href="{{ article.url }}" target="_blank" rel="noopener">查看西语原文 ↗</a>
        </div>
      </header>

      <!-- 新闻重点 -->
      <section class="article-section">
        <h2>📋 新闻重点</h2>
        <table class="info-table">
          <tr><th>发布部委</th><td>{{ article.department | default("未知") }}</td></tr>
          <tr><th>发布日期</th><td>{{ article.date | default("未知") }}</td></tr>
          {% if article.deadline_date %}<tr><th>截止 / 生效日</th><td>{{ article.deadline_date }}</td></tr>{% endif %}
          {% if article.tags %}<tr><th>涉及领域</th><td>{{ article.tags | join("　·　") }}</td></tr>{% endif %}
        </table>
      </section>

      <!-- 新闻概述 -->
      {% set po = zh.professional_overview | default("") %}
      {% if po %}
      <section class="article-section overview-box">
        <h2>🔍 新闻概述</h2>
        <div class="prose">
          {% for line in po.split('\n') %}{% if line.strip() %}<p>{{ line.strip() }}</p>{% endif %}{% endfor %}
        </div>
      </section>
      {% endif %}

      <!-- 西班牙本地人视角 -->
      {% if zh.local_perspective %}
      <section class="article-section">
        <h2>🏡 西班牙本地人视角</h2>
        <div class="prose">
          {% for line in zh.local_perspective.split('\n') %}
          {% if line.strip() %}<p>{{ line.strip() }}</p>{% endif %}
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <!-- 对在西华人的影响 -->
      {% if zh.china_resident_angle %}
      <section class="article-section advice-box resident-box">
        <h2>💡 对在西华人的影响与建议</h2>
        <div class="prose">
          {% for line in zh.china_resident_angle.split('\n') %}
          {% if line.strip() %}<p>{{ line.strip() }}</p>{% endif %}
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <!-- 快捷操作 -->
      <section class="article-section action-section">
        <h2>🔗 快捷操作</h2>
        <div class="action-buttons">
          <a class="action-btn btn-source" href="{{ article.url }}" target="_blank" rel="noopener">
            📰 查看西语原文
          </a>
        </div>
      </section>

      <!-- 实用信息 -->
      <section class="article-section">
        <h2>ℹ️ 实用信息</h2>
        <ul class="info-list">
          <li><strong>原文链接：</strong><a href="{{ article.url }}" target="_blank" rel="noopener">{{ article.url }}</a></li>
          <li><strong>发布部委：</strong>{{ article.department | default("未知") }}</li>
          <li><strong>发布日期：</strong>{{ article.date | default("未知") }}</li>
          {% if article.deadline_date %}<li><strong>截止 / 生效日：</strong>{{ article.deadline_date }}</li>{% endif %}
          {% if article.tags %}<li><strong>关键词：</strong>{{ article.tags | join("、") }}</li>{% endif %}
        </ul>
      </section>

    </article>
  </div>
</div>
{% endblock %}
