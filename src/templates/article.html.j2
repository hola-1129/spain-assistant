{% extends "base.html.j2" %}
{% set assets_path = "../assets/style.css" %}
{% set root_path = "../index.html" %}
{% set zh = article.zh | default({}) %}
{% set event = zh.event | default({}) %}
{% set loc = zh.location_info | default({}) %}
{% set kp = zh.key_points | default({}) %}

{% block footer_source %}<a href="https://diario.madrid.es/blog/notas-de-prensa/" target="_blank" rel="noopener">Diario de Madrid</a>{% endblock %}

{% block title %}{{ zh.chinese_title | default(article.title) }} · 马德里今日生活情报{% endblock %}

{% block content %}
<div class="article-page">

  <!-- 顶部图片区 -->
  {% set images = article.images | default([]) %}
  {% if images %}
  <div class="article-hero-img">
    <img src="{{ images[0].url }}" alt="{{ images[0].alt | default('') }}" onerror="this.parentElement.style.display='none'" />
    <div class="img-credit">图片来源：Ayuntamiento de Madrid / Diario de Madrid</div>
  </div>
  {% elif article.thumbnail %}
  <div class="article-hero-img">
    <img src="{{ article.thumbnail }}" alt="" onerror="this.parentElement.style.display='none'" />
    <div class="img-credit">图片来源：Ayuntamiento de Madrid / Diario de Madrid</div>
  </div>
  {% endif %}

  <div class="container">
    <nav class="breadcrumb">
      <a href="../index.html">首页</a> <span>›</span> 文章详情
    </nav>

    <article class="article-content">

      <!-- 标签区 -->
      <div class="article-badges">
        <span class="badge imp-badge imp-{{ article.importance | lower }}">
          {% if article.importance == 'S' %}⚡ 必须关注
          {% elif article.importance == 'A' %}⭐ 值得关注
          {% elif article.importance == 'B' %}📌 可参考
          {% else %}📄 仅供参考{% endif %}
        </span>
        {% for label in (article.labels | default([]))[:4] %}
        <span class="badge label-badge">{{ label }}</span>
        {% endfor %}
      </div>

      <!-- 标题区 -->
      <header class="article-header">
        <h1 class="article-title">{{ zh.chinese_title | default(article.title) }}</h1>
        {% if zh.one_line_summary %}
        <p class="article-lead">{{ zh.one_line_summary }}</p>
        {% endif %}
        <div class="article-meta-row">
          {% if article.date %}<span>🗓 {{ article.date }}</span>{% endif %}
          {% if loc.name %}<span>📍 {{ loc.name }}</span>{% endif %}
          {% if article.area_label %}
          <span class="area-badge">{{ article.area_label }}{% if article.area_district and article.area_district != article.area_label %} / {{ article.area_district }}{% endif %}</span>
          {% endif %}
          <a class="meta-source" href="{{ article.url }}" target="_blank" rel="noopener">查看西语原文 ↗</a>
        </div>
      </header>

      <!-- 新闻重点 -->
      <section class="article-section">
        <h2>📋 新闻重点</h2>
        <table class="info-table">
          <tr><th>时间</th><td>{{ kp.time | default("原文未说明") }}</td></tr>
          <tr><th>地点</th><td>{{ kp.location | default("原文未说明") }}</td></tr>
          <tr><th>涉及人群</th><td>{{ kp.audience | default("原文未说明") }}</td></tr>
          <tr><th>具体内容</th><td>{{ kp.change | default("原文未说明") }}</td></tr>
          <tr><th>费用/报名/时间</th><td>{{ kp.practical | default("原文未说明") }}</td></tr>
        </table>
      </section>

      <!-- 新闻概述 -->
      {% set po = zh.professional_overview | default("") %}
      {% if po %}
      <section class="article-section overview-box">
        <h2>🔍 新闻概述</h2>
        <div class="prose">
          {% for line in po.split('\n') %}{% if line.strip() %}<p>{{ line.strip() }}</p>{% endif %}{% endfor %}
        </div>
      </section>
      {% endif %}

      <!-- 马德里本地人视角 -->
      {% set lp = zh.local_perspective | default("") %}
      {% if lp %}
      <section class="article-section">
        <h2>🏡 马德里本地人视角</h2>
        <div class="prose">
          {% for line in lp.split('\n') %}{% if line.strip() %}<p>{{ line.strip() }}</p>{% endif %}{% endfor %}
        </div>
      </section>
      {% endif %}

      <!-- 给在马德里华人的建议 -->
      {% set ta = zh.tourist_advice | default("") %}
      {% set ra = zh.resident_advice | default("") %}
      {% if ta or ra %}
      <section class="article-section advice-box">
        <h2>💡 给在马德里华人的建议</h2>
        <ul class="advice-list">
          {% for line in (ra + '\n' + ta).split('\n') %}
          {% set l = line.strip().lstrip('-').strip() %}
          {% if l %}<li>{{ l }}</li>{% endif %}
          {% endfor %}
        </ul>
      </section>
      {% endif %}

      <!-- 快捷操作 -->
      <section class="article-section action-section">
        <h2>🔗 快捷操作</h2>
        <div class="action-buttons">
          {% if article.ics_path %}
          <a class="action-btn btn-apple" href="../{{ article.ics_path }}" download>
            <svg width="13" height="16" viewBox="0 0 13 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M10.8 8.1c0-1.85 1.5-2.75 1.5-2.75s-.85-1.2-2.2-1.5c-.95-.2-1.9.6-2.3.6-.45 0-1.3-.58-2.1-.55C4.1 4 2.75 4.8 2.1 6.05c-1.4 2.4-.38 5.9.9 7.7.65.9 1.4 1.95 2.4 1.9.95-.04 1.3-.62 2.5-.62s1.5.62 2.5.62c1.05-.02 1.72-.98 2.32-1.9.5-.65.85-1.38 1.05-2.1-1.85-.73-3.0-2.62-2.97-3.55z" fill="white"/>
              <path d="M8.9 2.5c.58-.72.86-1.65.76-2.5-.9.08-1.78.58-2.3 1.3-.48.68-.78 1.6-.72 2.5.92-.02 1.8-.5 2.26-1.3z" fill="white"/>
            </svg>
            添加到 Apple Calendar
          </a>
          {% endif %}
          {% if article.maps_url %}
          <a class="action-btn btn-maps" href="{{ article.maps_url }}" target="_blank" rel="noopener">
            <svg width="14" height="19" viewBox="0 0 14 19" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M7 0C3.13 0 0 3.13 0 7c0 5.25 7 12 7 12S14 12.25 14 7c0-3.87-3.13-7-7-7z" fill="#EA4335"/>
              <circle cx="7" cy="7" r="2.8" fill="white"/>
            </svg>
            {% if article.maps_url_type == "specific" %}在 Google Maps 中打开{% else %}查看地图搜索{% endif %}
          </a>
          {% endif %}
          <a class="action-btn btn-source" href="{{ article.url }}" target="_blank" rel="noopener">
            📰 查看西语原文
          </a>
        </div>
        {% if event.has_event %}
        <div class="event-info">
          <strong>活动信息：</strong>
          {% if event.start_date %}{{ event.start_date }}{% if event.end_date and event.end_date != event.start_date %} — {{ event.end_date }}{% endif %}{% endif %}
          {% if event.start_time %} {{ event.start_time }}{% if event.end_time %} — {{ event.end_time }}{% endif %}{% endif %}
          {% if event.location %} · {{ event.location }}{% endif %}
        </div>
        {% endif %}
      </section>

      <!-- 实用信息 -->
      <section class="article-section">
        <h2>ℹ️ 实用信息</h2>
        <ul class="info-list">
          <li><strong>原文链接：</strong><a href="{{ article.url }}" target="_blank" rel="noopener">{{ article.url }}</a></li>
          <li><strong>发布日期：</strong>{{ article.date | default("未知") }}</li>
          {% if loc.address and loc.address not in ["原文未说明", ""] %}<li><strong>地址：</strong>{{ loc.address }}</li>{% endif %}
          {% if zh.keywords %}<li><strong>关键词：</strong>{{ zh.keywords | join("、") }}</li>{% endif %}
        </ul>
      </section>

    </article>
  </div>
</div>
{% endblock %}
