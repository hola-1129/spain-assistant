{% extends "base.html.j2" %}
{% set assets_path = "assets/style.css" %}
{% set root_path = "index.html" %}

{% block title %}{{ today }} · 马德里今日生活情报{% endblock %}

{% block content %}
<!-- Hero -->
<section class="hero">
  <div class="container">
    <p class="hero-desc">为在马德里的华人家庭筛选真正值得关注的本地新闻、活动与市政提醒</p>
    <div class="hero-meta">{{ today }} &nbsp;·&nbsp; 更新于 {{ now }}</div>
    <div class="hero-stats">
      <div class="stat-item">
        <span class="stat-num">{{ stats.total }}</span>
        <span class="stat-label">今日新闻</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">{{ stats.important }}</span>
        <span class="stat-label">重点关注</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">{{ stats.family }}</span>
        <span class="stat-label">亲子教育</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">{{ stats.culture_art }}</span>
        <span class="stat-label">文化活动</span>
      </div>
    </div>
  </div>
</section>

<div class="container page-body">

  <!-- 筛选栏 -->
  <div class="filter-bar" id="filters">
    <button class="filter-btn active" data-filter="all">全部</button>
    <button class="filter-btn" data-filter="S">⚡ 必看</button>
    <button class="filter-btn" data-filter="A">⭐ 重点</button>
    <button class="filter-btn" data-filter="亲子">👶 亲子</button>
    <button class="filter-btn" data-filter="教育">🏫 教育</button>
    <button class="filter-btn" data-filter="交通">🚗 交通</button>
    <button class="filter-btn" data-filter="文化">🎭 文化</button>
    <button class="filter-btn" data-filter="艺术">🎨 艺术</button>
    <button class="filter-btn" data-filter="体育">⚽ 体育</button>
    <button class="filter-btn" data-filter="游客相关">✈️ 游客</button>
    <button class="filter-btn" data-filter="本地定居者相关">🏠 定居者</button>
  </div>

  {% if not articles %}
  <div class="empty-state">
    <div class="empty-icon">📭</div>
    <p>今日暂无新发布新闻</p>
    <p class="empty-sub">请稍后再来，或查看 <a href="archive/">历史归档</a></p>
  </div>
  {% else %}

  <!-- 今日马德里 -->
  {% if articles %}
  <section class="section-block">
    <h2 class="section-title"><span class="title-dot"></span>🏙 今日马德里</h2>
    <div class="card-grid">
      {% for art in articles %}
      {% set zh = art.zh | default({}) %}
      <a class="card card--featured imp-{{ art.importance | lower }}"
         href="{{ art.article_url }}"
         data-imp="{{ art.importance }}"
         data-labels="{{ (art.labels | default([])) | join(',') }}">
        {% if art.cover_image %}
        <div class="card-img">
          <img src="{{ art.cover_image }}" alt="{{ zh.chinese_title | default('') }}" loading="lazy" onerror="this.parentElement.style.display='none'" />
        </div>
        {% endif %}
        <div class="card-body">
          <div class="card-badges">
            <span class="badge imp-badge imp-{{ art.importance | lower }}">{{ art.importance }}</span>
            {% for label in (art.labels | default([]))[:3] %}
            <span class="badge label-badge">{{ label }}</span>
            {% endfor %}
          </div>
          <h3 class="card-title">{{ zh.chinese_title | default(art.title) }}</h3>
          {% if zh.one_line_summary %}<p class="card-summary">{{ zh.one_line_summary }}</p>{% endif %}
          <div class="card-foot">
            <span class="card-date">{{ art.date | default("") }}</span>
            {% if art.area_label %}<span class="card-loc">📍 {{ art.area_label }}</span>
            {% else %}{% set loc = zh.location_info | default({}) %}{% if loc.name %}<span class="card-loc">📍 {{ loc.name }}</span>{% endif %}{% endif %}
            <span class="card-cta">查看详情 →</span>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- 西班牙全国重点 -->
  {% if national_articles %}
  <section class="section-block">
    <h2 class="section-title"><span class="title-dot"></span>🇪🇸 西班牙全国重点</h2>
    <div class="card-grid">
      {% for art in national_articles %}
      {% set zh = art.zh | default({}) %}
      <a class="card card--national imp-{{ art.importance | lower }}"
         href="{{ art.article_url }}"
         data-imp="{{ art.importance }}"
         data-labels="{{ (art.tags | default([])) | join(',') }}">
        {% if art.thumbnail %}
        <div class="card-img">
          <img src="{{ art.thumbnail }}" alt="{{ zh.chinese_title | default('') }}" loading="lazy" onerror="this.parentElement.style.display='none'" />
        </div>
        {% endif %}
        <div class="card-body">
          <div class="card-badges">
            <span class="badge imp-badge imp-{{ art.importance | lower }}">{{ art.importance }}</span>
            <span class="badge" style="background:#1d4ed8;color:#fff;font-size:0.7rem;">🏛 {{ art.department | truncate(14, true, '…') }}</span>
            {% for tag in (art.tags | default([]))[:2] %}
            <span class="badge label-badge">{{ tag }}</span>
            {% endfor %}
          </div>
          <h3 class="card-title">{{ zh.chinese_title | default(art.title) }}</h3>
          {% if zh.one_line_summary %}<p class="card-summary">{{ zh.one_line_summary }}</p>{% endif %}
          <div class="card-foot">
            <span class="card-date">🇪🇸 {{ art.date | default("") }}</span>
            {% if art.valid_until %}<span class="card-date" style="color:#92400e;">至 {{ art.valid_until }}</span>{% endif %}
            <span class="card-cta">查看详情 →</span>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- Agenda Madrid 本地活动 -->
  {% if agenda_articles %}
  <section class="section-block">
    <h2 class="section-title"><span class="title-dot"></span>🎨 Agenda Madrid｜今日活动</h2>
    <div class="card-grid">
      {% for ev in agenda_articles %}
      {% set zh = ev.zh | default({}) %}
      {% set ev_img = ev.image_url if ev.image_url is string else (ev.image_url[0] if ev.image_url else "") %}
      <div class="card card--agenda imp-{{ ev.importance | lower }}"
           data-imp="{{ ev.importance }}"
           data-labels="{{ (ev.tags | default([])) | join(',') }}">
        {% if ev_img %}
        <div class="card-img">
          <img src="{{ ev_img }}" alt="{{ zh.chinese_title | default(ev.title) }}" loading="lazy" onerror="this.parentElement.style.display='none'" />
        </div>
        {% endif %}
        <div class="card-body">
          <div class="card-badges">
            <span class="badge imp-badge imp-{{ ev.importance | lower }}">{{ ev.importance }}</span>
            {% if ev.price_info and ev.price_info not in ["原文未说明", ""] %}
            <span class="badge" style="background:#059669;color:#fff;font-size:0.7rem;">{{ ev.price_info | truncate(12, true, '…') }}</span>
            {% endif %}
            {% for tag in (ev.tags | default([]))[:3] %}
            <span class="badge label-badge">{{ tag }}</span>
            {% endfor %}
          </div>
          <h3 class="card-title">{{ zh.chinese_title | default(ev.title) }}</h3>
          {% if zh.one_line_summary %}<p class="card-summary">{{ zh.one_line_summary }}</p>{% endif %}
          {% if ev.audience %}<p class="card-summary" style="color:#6b7280;font-size:0.78rem;">适合：{{ ev.audience | join(" · ") }}</p>{% endif %}
          <div class="card-foot">
            {% if ev.date_start %}
            <span class="card-chip">📅 {{ ev.date_start }}{% if ev.date_end and ev.date_end != ev.date_start %} ~ {{ ev.date_end }}{% endif %}</span>
            {% endif %}
            {% if ev.area_label and ev.area_label != "Madrid" %}<span class="card-chip">📍 {{ ev.area_label }}</span>
            {% elif ev.location_name and ev.location_name not in ["--", ""] %}<span class="card-chip">📍 {{ ev.location_name | truncate(14) }}</span>{% endif %}
            {% if ev.maps_url and ev.location_name not in ["--", ""] %}
            <a class="card-map-btn" href="{{ ev.maps_url }}" target="_blank" rel="noopener">🗺 地图</a>
            {% endif %}
            <a class="card-cta card-cta--stretch" href="{{ ev.article_url }}">查看详情 →</a>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% endif %}

  <!-- 持续关注（跨日仍在有效期内的重点新闻，仅展示，不跳转）-->
  {% if persistent_highlights %}
  <section class="section-block">
    <h2 class="section-title"><span class="title-dot"></span>持续关注</h2>
    <div class="card-grid">
      {% for art in persistent_highlights %}
      {% set zh = art.zh | default({}) %}
      <a class="card card--featured imp-{{ art.importance | lower }}"
         href="{{ art.article_url }}"
         data-imp="{{ art.importance }}"
         data-labels="{{ (art.labels | default(art.tags | default([]))) | join(',') }}">
        {% if art.cover_image %}
        <div class="card-img">
          <img src="{{ art.cover_image }}" alt="{{ zh.chinese_title | default('') }}" loading="lazy" onerror="this.parentElement.style.display='none'" />
        </div>
        {% endif %}
        <div class="card-body">
          <div class="card-badges">
            <span class="badge imp-badge imp-{{ art.importance | lower }}">{{ art.importance }}</span>
            <span class="badge" style="background:#f59e0b;color:#fff;">至 {{ art.valid_until }}</span>
            {% for label in (art.labels | default(art.tags | default([])))[:2] %}
            <span class="badge label-badge">{{ label }}</span>
            {% endfor %}
          </div>
          <h3 class="card-title">{{ zh.chinese_title | default(art.title) }}</h3>
          {% if zh.one_line_summary %}<p class="card-summary">{{ zh.one_line_summary }}</p>{% endif %}
          <div class="card-foot">
            <span class="card-date">{{ art.date | default("") }}</span>
            {% if art.area_label %}<span class="card-loc">📍 {{ art.area_label }}</span>
            {% else %}{% set loc = zh.location_info | default({}) %}{% if loc.name %}<span class="card-loc">📍 {{ loc.name }}</span>{% endif %}{% endif %}
            <span class="card-cta">查看详情 →</span>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- 历史归档 -->
  <section class="section-block archive-link-block">
    <a href="archive/" class="archive-link">查看历史归档 →</a>
  </section>

</div>

<script>
(function(){
  var btns = document.querySelectorAll('.filter-btn');
  var cards = document.querySelectorAll('.card[data-imp]');
  btns.forEach(function(btn){
    btn.addEventListener('click', function(){
      btns.forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      var f = btn.dataset.filter;
      cards.forEach(function(card){
        var imp = card.dataset.imp || '';
        var labels = card.dataset.labels || '';
        var show = f === 'all'
          || (f === 'S' && imp === 'S')
          || (f === 'A' && imp === 'A')
          || labels.indexOf(f) !== -1;
        card.style.display = show ? '' : 'none';
      });
    });
  });
})();
</script>
{% endblock %}
