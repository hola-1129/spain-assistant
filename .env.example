# ai_workspace — 全局 .env 模板
# 复制为 .env 并填写真实值，不要提交到 Git
#
# 所有 agent 共享此文件，通过 docker-compose env_file 注入容器。

# ── Telegram（所有 agent 共用同一个 bot）────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LLM API Keys ────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=
LLM_API_KEY=            # spain_assistant 使用：指向 OpenAI 或 Qwen
LLM_BASE_URL=           # 可选，Qwen 填：https://dashscope.aliyuncs.com/compatible-mode/v1

# ── GitHub Pages（spain_assistant）─────────────────────
GITHUB_TOKEN=           # repo 写入权限

# ── Web3 Monitor ────────────────────────────────────────
POLYMARKET_WALLET=      # 可选，监控持仓用
