# Spain Assistant 环境变量模板
# 复制此文件为 .env 并填写真实值
# 不要将 .env 提交到 Git

# === LLM 配置 ===
LLM_API_KEY=your_openai_or_qwen_api_key_here
LLM_BASE_URL=                          # 可选，留空使用默认端点（Qwen填写 https://dashscope.aliyuncs.com/compatible-mode/v1）

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here    # 个人或群组 chat_id

# === GitHub Pages 发布 ===
GITHUB_TOKEN=your_github_token_here   # 需要 repo 写入权限
